<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SampleApp.Pages.BasicPage"
             Title="Basic Popups">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Basic Popups"
                   FontSize="24" FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="Core popup features"
                   FontSize="14" TextColor="Gray"
                   HorizontalOptions="Center" />

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,10" />

            <Label Text="Simple Popup" FontAttributes="Bold" />
            <Label Text="Tap background to dismiss" FontSize="12" TextColor="Gray" />
            <Button Text="Show Simple Popup" Clicked="OnSimplePopupClicked" />

            <BoxView HeightRequest="1" Color="LightGray" />

            <Label Text="Return String Value" FontAttributes="Bold" />
            <Label Text="Type text and get it back" FontSize="12" TextColor="Gray" />
            <Button Text="Show String Popup" Clicked="OnReturnStringClicked" />
            <Label x:Name="StringResultLabel" Text="Result: (none)" TextColor="Gray" />

            <BoxView HeightRequest="1" Color="LightGray" />

            <Label Text="Return Typed Object" FontAttributes="Bold" />
            <Label Text="Fill a form, get UserInfo back" FontSize="12" TextColor="Gray" />
            <Button Text="Show Object Popup" Clicked="OnReturnObjectClicked" />
            <Label x:Name="ObjectResultLabel" Text="Result: (none)" TextColor="Gray" />

            <BoxView HeightRequest="1" Color="LightGray" />

            <Label Text="Confirm Dialog (Yes/No)" FontAttributes="Bold" />
            <Label Text="Returns bool result" FontSize="12" TextColor="Gray" />
            <Button Text="Show Confirm Popup" Clicked="OnConfirmPopupClicked" />
            <Label x:Name="BoolResultLabel" Text="Result: (none)" TextColor="Gray" />

            <BoxView HeightRequest="1" Color="LightGray" />

            <Label Text="Stacked Popups" FontAttributes="Bold" />
            <Label Text="Open popups on top of each other" FontSize="12" TextColor="Gray" />
            <Button Text="Show Stacked Popup" Clicked="OnStackedPopupClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
