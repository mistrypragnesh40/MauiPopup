<?xml version="1.0" encoding="utf-8" ?>
<mauiPopup:BasePopupPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                         xmlns:mauiPopup="clr-namespace:MauiPopup.Views;assembly=MauiPopup"
                         x:Class="SampleApp.Popups.FullPagePopup">

    <Grid BackgroundColor="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="#1565C0" Padding="20" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Text="X" FontSize="20" TextColor="White"
                   VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseClicked" />
                </Label.GestureRecognizers>
            </Label>

            <Label Grid.Column="1" Text="Full Page Popup"
                   FontSize="20" FontAttributes="Bold"
                   TextColor="White" VerticalOptions="Center" />
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1" Padding="20">
            <VerticalStackLayout Spacing="20">
                <Label Text="This is a full-page popup that covers the entire screen."
                       FontSize="16" />

                <Frame BackgroundColor="#E3F2FD" Padding="15" CornerRadius="8">
                    <Label Text="Full page popups are useful for complex forms, image viewers, detail pages, or any content that needs maximum space." />
                </Frame>

                <Label Text="Features demonstrated:" FontAttributes="Bold" FontSize="16" />
                <Label Text="  - VerticalOptions = Fill" />
                <Label Text="  - HorizontalOptions = Fill" />
                <Label Text="  - Margin = 0 (edge to edge)" />
                <Label Text="  - Custom header with close button" />
                <Label Text="  - IsCloseOnBackgroundClick = false" />
                <Label Text="  - Scale animation" />

                <BoxView HeightRequest="1" Color="LightGray" />

                <Entry Placeholder="Try typing something..." />
                <Editor Placeholder="Or write longer text here..."
                        HeightRequest="100" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Footer -->
        <Grid Grid.Row="2" Padding="20" BackgroundColor="#F5F5F5">
            <Button Text="Close Full Page Popup"
                    Clicked="OnCloseClicked"
                    BackgroundColor="#1565C0" TextColor="White" />
        </Grid>
    </Grid>

</mauiPopup:BasePopupPage>
