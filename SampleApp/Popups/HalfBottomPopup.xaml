<?xml version="1.0" encoding="utf-8" ?>
<mauiPopup:BasePopupPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                         xmlns:mauiPopup="clr-namespace:MauiPopup.Views;assembly=MauiPopup"
                         x:Class="SampleApp.Popups.HalfBottomPopup">

    <Grid BackgroundColor="White" HeightRequest="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Handle bar -->
        <StackLayout Grid.Row="0" Padding="0,10">
            <BoxView HeightRequest="4" WidthRequest="40"
                     CornerRadius="2" Color="LightGray"
                     HorizontalOptions="Center" />
        </StackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1" Padding="20">
            <VerticalStackLayout Spacing="15">
                <Label Text="Bottom Half Sheet"
                       FontSize="22" FontAttributes="Bold" />

                <Label Text="This popup covers the bottom half of the screen, like a standard bottom sheet." />

                <Label Text="Common uses:" FontAttributes="Bold" />
                <Label Text="  - Share menus" />
                <Label Text="  - Action sheets" />
                <Label Text="  - Filter panels" />
                <Label Text="  - Quick edit forms" />

                <BoxView HeightRequest="1" Color="LightGray" />

                <Label Text="Tap background or press Close to dismiss"
                       FontSize="12" TextColor="Gray"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Footer -->
        <Button Grid.Row="2" Text="Close"
                Margin="20,10" Clicked="OnCloseClicked" />
    </Grid>

</mauiPopup:BasePopupPage>
