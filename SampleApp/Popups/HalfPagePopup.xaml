<?xml version="1.0" encoding="utf-8" ?>
<mauiPopup:BasePopupPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                         xmlns:mauiPopup="clr-namespace:MauiPopup.Views;assembly=MauiPopup"
                         x:Class="SampleApp.Popups.HalfPagePopup">

    <Grid BackgroundColor="White" HeightRequest="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackLayout Grid.Row="0" BackgroundColor="#6200EE" Padding="20">
            <Label Text="Half Page Popup"
                   FontSize="22" FontAttributes="Bold"
                   TextColor="White" />
            <Label Text="This covers the top half of the screen"
                   FontSize="14" TextColor="#E0E0E0" />
        </StackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1" Padding="20">
            <VerticalStackLayout Spacing="15">
                <Label Text="This popup demonstrates a half-screen overlay anchored to the top. It's useful for:" />
                <Label Text="  - Notification panels" />
                <Label Text="  - Search overlays" />
                <Label Text="  - Quick settings" />
                <Label Text="  - Menu drawers from top" />

                <BoxView HeightRequest="1" Color="LightGray" />

                <Label Text="The popup uses VerticalOptions = Start and HorizontalOptions = Fill with a fixed height to achieve this effect."
                       FontSize="12" TextColor="Gray" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Footer -->
        <Button Grid.Row="2" Text="Close"
                Margin="20" Clicked="OnCloseClicked" />
    </Grid>

</mauiPopup:BasePopupPage>
