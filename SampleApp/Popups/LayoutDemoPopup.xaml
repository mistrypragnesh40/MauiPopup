<?xml version="1.0" encoding="utf-8" ?>
<mauiPopup:BasePopupPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                         xmlns:mauiPopup="clr-namespace:MauiPopup.Views;assembly=MauiPopup"
                         x:Class="SampleApp.Popups.LayoutDemoPopup">

    <Frame Padding="20" CornerRadius="10" WidthRequest="250">
        <VerticalStackLayout Spacing="10">
            <Label x:Name="PositionLabel"
                   FontSize="18" FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="Tap background to close"
                   FontSize="12" TextColor="Gray"
                   HorizontalTextAlignment="Center" />

            <Button Text="Close" Clicked="OnCloseClicked" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Frame>

</mauiPopup:BasePopupPage>
