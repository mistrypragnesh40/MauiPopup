<?xml version="1.0" encoding="utf-8" ?>
<mauiPopup:BasePopupPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                         xmlns:mauiPopup="clr-namespace:MauiPopup.Views;assembly=MauiPopup"
                         x:Class="SampleApp.Popups.SidePanelPopup">

    <Grid BackgroundColor="White" WidthRequest="280">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackLayout Grid.Row="0" BackgroundColor="#FF5722" Padding="20">
            <Label Text="Side Panel" FontSize="20"
                   FontAttributes="Bold" TextColor="White" />
            <Label Text="Right-anchored menu" FontSize="12" TextColor="#FFE0E0" />
        </StackLayout>

        <VerticalStackLayout Grid.Row="1" Padding="20" Spacing="15">
            <Label Text="Menu Item 1" FontSize="16" />
            <Label Text="Menu Item 2" FontSize="16" />
            <Label Text="Menu Item 3" FontSize="16" />
            <Label Text="Menu Item 4" FontSize="16" />

            <BoxView HeightRequest="1" Color="LightGray" />

            <Button Text="Close Panel" Clicked="OnCloseClicked" />
        </VerticalStackLayout>
    </Grid>

</mauiPopup:BasePopupPage>
