<?xml version="1.0" encoding="utf-8" ?>
<mauiPopup:BasePopupPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                         xmlns:mauiPopup="clr-namespace:MauiPopup.Views;assembly=MauiPopup"
                         x:Class="SampleApp.Popups.StackedPopup">

    <Frame Padding="20" CornerRadius="10" WidthRequest="280">
        <VerticalStackLayout Spacing="15">
            <Label x:Name="TitleLabel"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label x:Name="MessageLabel"
                   HorizontalTextAlignment="Center" />

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="Open Another" Clicked="OnOpenAnotherClicked" />
                <Button Text="Close" Clicked="OnCloseClicked" BackgroundColor="Gray" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Frame>

</mauiPopup:BasePopupPage>
