<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiPopup.Views.BasePopupPage"
             x:Name="this"
             Title="BasePopupPage">
    <ContentPage.ControlTemplate>
        <ControlTemplate>
            <Grid BackgroundColor="{Binding Source={x:Reference this},Path=OverlayColor}">
                <Border VerticalOptions="{Binding Source={x:Reference this},Path=VerticalOptions}"
                        HorizontalOptions="{Binding Source={x:Reference this},Path=HorizontalOptions}"
                        BackgroundColor="{Binding Source={x:Reference this},Path=ForegroundColor}"
                        Margin="{Binding Source={x:Reference this},Path=Margin}"
                        Padding="{Binding Source={x:Reference this},Path=ContentPadding}"
                        Stroke="Transparent"
                        StrokeThickness="0"
                        StrokeShape="{Binding Source={x:Reference this},Path=PopupStrokeShape}">
                    <ContentPresenter>
                        <ContentPresenter.GestureRecognizers>
                            <TapGestureRecognizer />
                        </ContentPresenter.GestureRecognizers>
                    </ContentPresenter>
                </Border>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={x:Reference this},Path=PopModelCommand}" />
                </Grid.GestureRecognizers>
            </Grid>
        </ControlTemplate>
    </ContentPage.ControlTemplate>
</ContentPage>
